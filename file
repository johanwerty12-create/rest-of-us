<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Last Light</title>
<style>
:root{color-scheme:dark;--bg:#1d231f}
html,body{height:100%;margin:0;background:var(--bg);overflow:hidden}
canvas{display:block;width:100%;height:100%;cursor:none;touch-action:none}
</style></head><body><canvas id="c"></canvas>
<script>
const c=document.getElementById('c'),x=c.getContext('2d');
let W,H;function rs(){W=c.width=innerWidth;H=c.height=innerHeight}addEventListener('resize',rs);rs();
const K={},M={x:0,y:0,d:0};
let p,bl,zs,pt,dc,wave,toSpawn,spawnT,score,over=0,started=0,banner=0,next=0,flash=0,best=0;
try{best=+localStorage.getItem('ll-best')||0}catch(e){}
addEventListener('keydown',e=>{K[e.code]=1;if(e.code==='KeyR')reload();if(e.code==='Enter'&&(over||!started))start()});
addEventListener('keyup',e=>K[e.code]=0);
c.addEventListener('pointermove',e=>{M.x=e.clientX;M.y=e.clientY});
c.addEventListener('pointerdown',e=>{M.x=e.clientX;M.y=e.clientY;M.d=1;if(over||!started)start()});
addEventListener('pointerup',()=>M.d=0);
function start(){p={x:W/2,y:H/2,hp:100,ammo:12,rl:0,cd:0,a:0};bl=[];zs=[];pt=[];dc=[];wave=0;score=0;over=0;started=1;nextWave()}
function nextWave(){wave++;toSpawn=4+wave*3;spawnT=1;banner=2;next=0}
function reload(){if(started&&!over&&p.rl<=0&&p.ammo<12)p.rl=1.1}
function spawn(){
  const s=Math.random()*4|0,m=30;let X,Y;
  if(s<1){X=-m;Y=Math.random()*H}else if(s<2){X=W+m;Y=Math.random()*H}else if(s<3){X=Math.random()*W;Y=-m}else{X=Math.random()*W;Y=H+m}
  const r=Math.random();let z={x:X,y:Y,hp:2,sp:60+wave*4,r:14,col:'#86a05f',v:10};
  if(r<.18){z.hp=1;z.sp=150+wave*3;z.r=11;z.col='#a9b865';z.v=15}
  else if(wave>2&&r<.28){z.hp=5;z.sp=52;z.r=21;z.col='#5f7a4a';z.v=40}
  zs.push(z)
}
function blood(X,Y,n,a){for(let i=0;i<n;i++){const d=a+(Math.random()-.5)*1.6,s=60+Math.random()*180;pt.push({x:X,y:Y,vx:Math.cos(d)*s,vy:Math.sin(d)*s,l:.4+Math.random()*.3})}}
function update(dt){
  if(!started||over)return;
  let dx=(K.KeyD||K.ArrowRight?1:0)-(K.KeyA||K.ArrowLeft?1:0),dy=(K.KeyS||K.ArrowDown?1:0)-(K.KeyW||K.ArrowUp?1:0);
  const L=Math.hypot(dx,dy)||1;p.x=Math.min(W-12,Math.max(12,p.x+dx/L*190*dt));p.y=Math.min(H-12,Math.max(12,p.y+dy/L*190*dt));
  p.a=Math.atan2(M.y-p.y,M.x-p.x);p.cd-=dt;
  if(p.rl>0){p.rl-=dt;if(p.rl<=0)p.ammo=12}
  if(M.d&&p.cd<=0&&p.rl<=0){
    if(p.ammo>0){p.ammo--;p.cd=.13;bl.push({x:p.x+Math.cos(p.a)*22,y:p.y+Math.sin(p.a)*22,vx:Math.cos(p.a)*900,vy:Math.sin(p.a)*900,l:.8});if(!p.ammo)reload()}else reload()
  }
  if(toSpawn>0){spawnT-=dt;if(spawnT<=0){spawn();toSpawn--;spawnT=Math.max(.25,1-wave*.05)}}
  for(const b of bl){b.x+=b.vx*dt;b.y+=b.vy*dt;b.l-=dt}
  for(const z of zs){
    const a=Math.atan2(p.y-z.y,p.x-z.x);z.a=a;z.x+=Math.cos(a)*z.sp*dt;z.y+=Math.sin(a)*z.sp*dt;
    for(const o of zs)if(o!==z){const ex=z.x-o.x,ey=z.y-o.y,d=Math.hypot(ex,ey),m=z.r+o.r;if(d>0&&d<m){z.x+=ex/d*(m-d)*.3;z.y+=ey/d*(m-d)*.3}}
    if(Math.hypot(p.x-z.x,p.y-z.y)<z.r+12){p.hp-=30*dt;flash=.15}
    for(const b of bl)if(b.l>0&&Math.hypot(b.x-z.x,b.y-z.y)<z.r+3){b.l=0;z.hp--;z.x+=b.vx*.012;z.y+=b.vy*.012;blood(z.x,z.y,5,Math.atan2(b.vy,b.vx))}
    if(z.hp<=0){score+=z.v;blood(z.x,z.y,14,Math.random()*6);dc.push({x:z.x,y:z.y,r:z.r*.9});if(dc.length>70)dc.shift()}
  }
  zs=zs.filter(z=>z.hp>0);bl=bl.filter(b=>b.l>0);
  for(const q of pt){q.x+=q.vx*dt;q.y+=q.vy*dt;q.vx*=.92;q.vy*=.92;q.l-=dt}pt=pt.filter(q=>q.l>0);
  flash=Math.max(0,flash-dt);banner=Math.max(0,banner-dt);
  if(!toSpawn&&!zs.length&&!next){next=1.8;p.hp=Math.min(100,p.hp+15)}
  if(next){next-=dt;if(next<=0)nextWave()}
  if(p.hp<=0){over=1;if(score>best){best=score;try{localStorage.setItem('ll-best',best)}catch(e){}}}
}
function txt(s,X,Y,sz,col,al){x.font=sz+'px Georgia,serif';x.textAlign=al||'center';x.fillStyle=col||'#e8e2cf';x.fillText(s,X,Y)}
function draw(){
  x.fillStyle='#2a332c';x.fillRect(0,0,W,H);
  x.strokeStyle='rgba(255,255,255,.035)';x.lineWidth=1;x.beginPath();
  for(let i=0;i<W;i+=48){x.moveTo(i,0);x.lineTo(i,H)}for(let j=0;j<H;j+=48){x.moveTo(0,j);x.lineTo(W,j)}x.stroke();
  if(!started){txt('Last Light',W/2,H/2-30,64);txt('Hold the dark back. Click or press Enter to start.',W/2,H/2+10,20,'#b9b29b');
    txt('Move: WASD or arrows   Aim: mouse   Shoot: hold click   Reload: R',W/2,H/2+44,16,'#8f8a78');return}
  x.fillStyle='rgba(120,20,16,.45)';for(const d of dc){x.beginPath();x.arc(d.x,d.y,d.r,0,7);x.fill()}
  for(const z of zs){
    x.save();x.translate(z.x,z.y);x.rotate(z.a);
    x.fillStyle=z.col;x.beginPath();x.arc(0,0,z.r,0,7);x.fill();
    x.fillRect(z.r*.4,-z.r*.9,z.r*.9,z.r*.4);x.fillRect(z.r*.4,z.r*.5,z.r*.9,z.r*.4);
    x.fillStyle='#b3261e';x.fillRect(z.r*.45,-z.r*.35,3,3);x.fillRect(z.r*.45,z.r*.2,3,3);x.restore()
  }
  x.fillStyle='#ffd98a';for(const b of bl){x.beginPath();x.arc(b.x,b.y,2.5,0,7);x.fill()}
  x.fillStyle='#b3261e';for(const q of pt)x.fillRect(q.x,q.y,3,3);
  if(!over){x.save();x.translate(p.x,p.y);x.rotate(p.a);x.fillStyle='#4a4f45';x.fillRect(6,-3,20,6);
    x.fillStyle=flash>0?'#e07a6e':'#e8d9a8';x.beginPath();x.arc(0,0,12,0,7);x.fill();x.restore()}
  const g=x.createRadialGradient(p.x,p.y,90,p.x,p.y,Math.max(W,H)*.6);g.addColorStop(0,'rgba(8,10,9,0)');g.addColorStop(1,'rgba(8,10,9,.78)');
  x.fillStyle=g;x.fillRect(0,0,W,H);
  x.fillStyle='rgba(255,255,255,.12)';x.fillRect(20,20,160,10);x.fillStyle=p.hp>30?'#86a05f':'#b3261e';x.fillRect(20,20,Math.max(0,p.hp)*1.6,10);
  txt(p.rl>0?'Reloading…':'Ammo '+p.ammo+' / 12',20,52,16,'#e8e2cf','left');
  txt('Wave '+wave,W-20,34,20,'#e8e2cf','right');txt('Score '+score+'   Best '+best,W-20,58,15,'#b9b29b','right');
  if(banner>0&&!over)txt('Wave '+wave,W/2,H*.25,40,'rgba(232,226,207,'+Math.min(1,banner)+')');
  if(!over){x.strokeStyle='#e8e2cf';x.lineWidth=1.5;x.beginPath();x.arc(M.x,M.y,9,0,7);x.moveTo(M.x-14,M.y);x.lineTo(M.x-5,M.y);x.moveTo(M.x+5,M.y);x.lineTo(M.x+14,M.y);x.moveTo(M.x,M.y-14);x.lineTo(M.x,M.y-5);x.moveTo(M.x,M.y+5);x.lineTo(M.x,M.y+14);x.stroke()}
  if(over){x.fillStyle='rgba(20,6,6,.7)';x.fillRect(0,0,W,H);txt('Overrun',W/2,H/2-30,56,'#e07a6e');
    txt('You reached wave '+wave+' with '+score+' points.',W/2,H/2+10,20);txt('Click or press Enter to try again.',W/2,H/2+44,16,'#b9b29b')}
}
let lt=performance.now();
(function loop(t){const dt=Math.min(.05,(t-lt)/1000);lt=t;update(dt);draw();requestAnimationFrame(loop)})(lt);
</script></body></html>
